# Local, OpenAI-compatible model endpoint — held CONSTANT across runs (REQ-MD-01)
# and PERMISSIVE so the guardrail is what's on trial, not the model's own refusal
# (REQ-MD-02). Ollama default shown; LM Studio uses http://localhost:1234/v1.
LLM_BASE_URL=http://localhost:11434/v1
MODEL=qwen2.5-7b-instruct
API_KEY=lm-studio

# Path to the AgenticGoat checkout (defaults to ./agentic-goat, the submodule).
# AGENTIC_GOAT_ROOT=./agentic-goat

# Set to 1 to validate configs without a submodule or a live model.
# GUARDRAIL_EVAL_DRY_RUN=1
