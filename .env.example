# OpenAI-compatible model endpoint, held CONSTANT across runs (REQ-MD-01) and
# PERMISSIVE so the guardrail is what's on trial, not the model's own refusal
# (REQ-MD-02). Pick ONE option below. Copy this file to `.env` (gitignored) and
# put your key there — never commit a real key.

# --- Option A: OpenRouter (no local model needed) --------------------------
# Make a key at https://openrouter.ai/keys, then set:
LLM_BASE_URL=https://openrouter.ai/api/v1
API_KEY=sk-or-...                      # your OpenRouter key (stays in .env, not git)
MODEL=qwen/qwen-2.5-7b-instruct        # any OpenRouter model id; prefer a permissive one

# --- Option B: a local model -----------------------------------------------
# Ollama:    LLM_BASE_URL=http://localhost:11434/v1   (API_KEY can be any placeholder)
# LM Studio: LLM_BASE_URL=http://localhost:1234/v1
#            MODEL=qwen2.5-7b-instruct

# Path to the AgenticGoat checkout (defaults to ./agentic-goat, the submodule).
# AGENTIC_GOAT_ROOT=./agentic-goat

# Set to 1 to validate configs without a submodule or a live model.
# GUARDRAIL_EVAL_DRY_RUN=1
