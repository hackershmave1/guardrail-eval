# Python
venv/
__pycache__/
*.pyc
.env

# Node / Promptfoo
node_modules/
.promptfoo/
output.json
promptfoo-errors.log

# Lab runtime state / evidence (regenerated each run)
**/state/
**/email_log.txt
**/exfil_log.json
**/chroma_db/
results/

# ub-mode quality-gate output (crapper, dryer, mutator)
.metrics/
target/

# Optional test-case catalog spreadsheet (ingest loads it when present): never committed
*.xlsx

# Editor-local settings
.vscode/

# Claude Code: track the shared project setup (rules, guard settings + hooks, project skills);
# keep per-machine files (settings.local.json, installed skills, skills-lock.json) out
.claude/*
!.claude/rules/
!.claude/hooks/
!.claude/settings.json
!.claude/skills/
.claude/skills/*
!.claude/skills/ship/
!.claude/skills/ub-mode/
skills-lock.json
